# ==============================================================================
# SkillBridge Frontend Environment Configuration Example
# Copy this file to .env.local and replace the placeholder values.
# ==============================================================================

# ─── Backend API Connection ───────────────────────────────────────────────────
# Base URL for SkillBridge Express backend API (no trailing slash)
VITE_API_BASE_URL=http://localhost:5000

# ─── Feature Flags ────────────────────────────────────────────────────────────
# Set to "true" to show DHRUV AI Assistant button in the navigation bar
VITE_DHRUV_ENABLED=true

# ─── Firebase Client SDK (Google OAuth Login) ─────────────────────────────────
# Retrieve these credentials from your Firebase Console under Project Settings > Web App
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project_id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project_id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id
