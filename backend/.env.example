PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@cluster0.mongodb.net/skillbridge?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRE=7d
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key

CLOUDINARY_API_SECRET=your_cloudinary_api_secret
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# --- JOB AGGREGATION FEATURE FLAGS ---
ENABLE_JOB_AGGREGATION=true
ENABLE_ADZUNA=false
ENABLE_GREENHOUSE=false
ENABLE_LEVER=false

# Shared secret for the automated GitHub Actions sync trigger (POST /api/jobs/internal-sync).
# Generate a long random string and set the same value in both Render's env vars
# and the repo's GitHub Actions secret (SYNC_SECRET_KEY).
SYNC_SECRET_KEY=replace_with_a_long_random_string
