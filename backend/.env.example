# ==============================================================================
# SkillBridge Backend Environment Configuration Example
# Copy this file to .env and replace the placeholder values.
# ==============================================================================

# ─── Server & Environment ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# ─── Database ─────────────────────────────────────────────────────────────────
# Primary MongoDB Connection URI (MongoDB Atlas or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jobportal?retryWrites=true&w=majority
# Fallback alias if MONGODB_URI is not set
MONGO_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/jobportal?retryWrites=true&w=majority

# ─── Authentication & Security ────────────────────────────────────────────────
# Secret used to sign JSON Web Tokens (min 32 random characters recommended)
JWT_SECRET=your_jwt_secret_key_minimum_32_characters_long

# ─── Admin Auto-Seed (Optional) ───────────────────────────────────────────────
# If set, automatically provisions/updates this primary admin account on server startup
SEED_ADMIN_EMAIL=admin@skillbridge.com
SEED_ADMIN_PASSWORD=YourStrongAdminPassword123!

# ─── AI Providers (DHRUV Career Coach & Description Generator) ─────────────────
# Groq API Key (Primary LLM for DHRUV: llama-3.3-70b-versatile, mixtral-8x7b)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Google Gemini API Key (Fallback LLM: gemini-2.0-flash-lite)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Job Aggregation & Sync Engine ───────────────────────────────────────────
# Master switch for syncing external jobs
ENABLE_JOB_AGGREGATION=true
USE_NEW_SYNC_ENGINE=true
SYNC_DRY_RUN=false
STORE_RAW_PAYLOADS=false

# Cron expression for automated job ingestion
# Default: "0 */6 * * *" (every 6 hours). For dev testing, use "0 * * * *" (hourly)
JOB_SYNC_INTERVAL=0 */6 * * *

# Adzuna Jobs API (https://developer.adzuna.com/)
ENABLE_ADZUNA=true
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_API_KEY=your_adzuna_api_key

# ATS Provider Integrations (Optional)
ENABLE_GREENHOUSE=false
ENABLE_LEVER=false

# ─── Cloudinary (File & Screenshot Uploads) ───────────────────────────────────
CLOUD_NAME=your_cloudinary_cloud_name
CLOUD_API_KEY=your_cloudinary_api_key
CLOUD_API_SECRET=your_cloudinary_api_secret

# ─── Email Notifications & Job Digest ─────────────────────────────────────────
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# ─── Telegram Bot (Support Tickets & Alerts) ──────────────────────────────────
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_CHAT_ID=your_telegram_chat_or_channel_id

# ─── Redis Cache & Background Queue (Optional) ────────────────────────────────
# Required if running BullMQ background crawlers or Redis rate limiting
REDIS_URL=redis://default:<password>@<host>:<port>

# ─── Firebase Admin SDK (Google OAuth Sign-In) ─────────────────────────────────
# Single-line JSON string of your Firebase service account credentials
FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your_project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@your_project.iam.gserviceaccount.com"}
# Alternatively, specify path to file:
# FIREBASE_SERVICE_ACCOUNT_PATH=./config/firebase-service-account.json
