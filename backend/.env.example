# ─── Database ─────────────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://<user>:<password>@cluster.mongodb.net/<dbname>?retryWrites=true&w=majority

# ─── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=replace_with_a_long_random_secret

# ─── Admin Seed (optional) ────────────────────────────────────────────────────
# If both variables are set, the server will ensure a single admin account
# exists with these credentials on every startup (creates it only if absent).
# If either variable is left blank, admin seeding is skipped entirely.
# DO NOT commit real credentials here — set them as private env vars on Render.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# ─── Server ───────────────────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Email (optional) ─────────────────────────────────────────────────────────
EMAIL_HOST=
EMAIL_PORT=
EMAIL_USER=
EMAIL_PASS=
