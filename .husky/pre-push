#!/usr/bin/env sh
echo "🛡️  [SkillBridge Quality Gate] Running local pre-push integrity checks..."

echo "📦 1/2 Verifying Frontend Production Build..."
cd frontend || exit 1
npm run build || {
  echo "❌ Frontend build failed! Push aborted."
  exit 1
}

echo "🧪 2/2 Verifying Backend Test Suite..."
cd ../backend || exit 1
npm test || {
  echo "❌ Backend tests failed! Push aborted."
  exit 1
}

echo "✅ All pre-push checks passed successfully! Proceeding with push."
